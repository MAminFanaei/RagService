# Dockerfile.base
# FROM docker.io/python:3.10-slim
FROM python:3.10-slim

# Install runtime + build dependencies in one layer
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    default-libmysqlclient-dev \
    gcc \
    && pip install --upgrade pip \
    && pip install poetry \
    && poetry config virtualenvs.create false \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy only dependency files first (layer cache will hold until these change)
COPY pyproject.toml poetry.lock ./

# Install only production dependencies
RUN poetry install --only main --without gpu,dev,test --no-root
# RUN poetry install --only main
RUN poetry install --only gpu --no-root