DB_POOL_SIZE= #🔴 # optimal 10 for 4 core cpu
DB_MAX_OVERFLOW= #🔴 # optimal 10 for 4 core cpu
REDIS_MAX_CONNECTIONS= #🔴  # optimal 10 for 4 core cpu

# Security
SECRET_KEY= #🔴
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database - MySQL 
DATABASE_URL=mysql+pymysql://raguser:ragpassword@mysql:3306/ENTER_YOUR_DB_NAME #🔴
MYSQL_DATABASE=  #🔴
MYSQL_USER= #🔴
MYSQL_PASSWORD= #🔴
MYSQL_ROOT_PASSWORD=#🔴
MYSQL_PORT = 3306

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD= #🔴
REDIS_DB=0
