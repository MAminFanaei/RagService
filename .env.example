PRICE_PER_MESSAGE=20000 #🔴
MAX_FREE_REJECTIONS=3 #🔴 # for the tests
MIN_MESSAGE_PURCHASE=1 #🔴
MAX_MESSAGE_PURCHASE=1000 #🔴

# CORS
CORS_ORIGINS=[""] #🔴
CORS_ALLOW_CREDENTIALS=true

# Admin
ADMIN_EMAIL= #🔴
ADMIN_PASSWORD= #🔴

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# FEATURE FLAGS / KILL SWITCHES
ENABLE_REGISTRATION = true
ENABLE_OAUTH_LOGIN = false #🔴
# PATH
DOC_PATH = #🔴


# PAYMENT SERVICE CONFIGURATION
# SEP (Saman Electronic Payment) Gateway

# Your terminal ID assigned by SEP 
SEP_TERMINAL_ID= #🔴

# SEP API endpoints (production URLs — no sandbox available)
SEP_PAYMENT_URL=#🔴
SEP_VERIFY_URL=#🔴
SEP_REVERSE_URL=#🔴
SEP_SEND_TOKEN_URL = ""
# Token validity in minutes (min: 20, max: 3600, default: 20)
SEP_TOKEN_EXPIRY_MIN=20

# ─────────────────────────────────────────────────────────────
# Callback & Frontend URLs
# ─────────────────────────────────────────────────────────────
# Full URL where SEP will redirect the buyer after payment
# Must be accessible from the internet
# Must match what you registered with SEP as your redirect URL
PAYMENT_CALLBACK_URL=#🔴

# Frontend page that shows payment result to the user
# The callback endpoint will HTTP 302 redirect here with query params:
#   ?payment_id=xxx&status=VERIFIED&amount=500000&ref_num=yyy
# FRONTEND_PAYMENT_RESULT_URL=https://yourfrontend.com/payment/result
FRONTEND_PAYMENT_RESULT_URL=#🔴

# ─────────────────────────────────────────────────────────────
# Payment Business Rules
# ─────────────────────────────────────────────────────────────
# Minimum payment amount in Rials
MIN_PAYMENT_AMOUNT=10000

# Maximum payment amount in Rials
MAX_PAYMENT_AMOUNT=500000000

# Minutes after verification that reversal is allowed
# SEP docs say 50 minutes, but you can set it lower for safety
PAYMENT_REVERSE_WINDOW_MINUTES=45

# ─────────────────────────────────────────────────────────────
# Distributed Locking (uses your existing Redis)
# ─────────────────────────────────────────────────────────────
# Maximum seconds to wait for acquiring a lock
PAYMENT_LOCK_TIMEOUT=30

# Seconds before a lock auto-expires (prevents deadlocks)
PAYMENT_LOCK_TTL=90

# ─────────────────────────────────────────────────────────────
# Verify Retry Settings
# ─────────────────────────────────────────────────────────────
# Max times to retry VerifyTransaction on network timeout
PAYMENT_VERIFY_MAX_RETRIES=3

# Seconds between retry attempts (exponential backoff applied)
PAYMENT_VERIFY_RETRY_DELAY=2

# HTTP timeout for SEP API calls (seconds)
SEP_HTTP_TIMEOUT=30


# OTP core
OTP_CODE_LENGTH=6
OTP_EXPIRE_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_VERIFY_TOKEN_EXPIRE_MINUTES=10

# Melipayamak primary (shared endpoint)
MELIPAYAMAK_BODY_ID=#🔴
MELIPAYAMAK_USERNAME=#🔴
MELIPAYAMAK_PASSWORD=#🔴
MELIPAYAMAK_REST_URL=#🔴
                     

# Reliability
SMS_PROVIDER_TIMEOUT_SECONDS=5
SMS_PROVIDER_MAX_RETRIES=2
SMS_PROVIDER_RETRY_BACKOFF_SECONDS=0.7 